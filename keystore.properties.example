# TeleBack Production Keystore Configuration
# Copy this file to 'keystore.properties' (which is git-ignored) and fill in your private signing details:
#
# storeFile=keystore/my-production-key.jks
# storePassword=my_keystore_password
# keyAlias=my_key_alias
# keyPassword=my_key_password
#
# Alternatively, configure environment variables:
# KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
storeFile=keystore/teleback-release-template.jks
storePassword=teleback_release
keyAlias=teleback
keyPassword=teleback_release
